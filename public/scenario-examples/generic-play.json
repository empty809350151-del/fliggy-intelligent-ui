  "program": "root = Col([title, instructions, game])\ntitle = Title(\"复古太空射击\", \"xl\")\ninstructions = Text(\"用 ← → 或 A/D 移动，空格开火；也可以用鼠标/手指在画布上移动和点击。击落敌机得分，被撞到会损失生命。\", \"sm\", \"muted\")\ngame = HtmlView(gameCode, 600, \"复古太空射击\")\ngameCode = \"<div style='display:flex;flex-direction:column;align-items:center;background:#0a0a18;padding:10px;border-radius:14px;font-family:monospace;'>\\n<canvas id='game' width='360' height='480' tabindex='0' style='width:100%;max-width:360px;height:auto;border:2px solid #333;border-radius:10px;outline:none;background:#05050f;cursor:crosshair;touch-action:none;'></canvas>\\n<div style='display:flex;gap:10px;margin-top:10px;flex-wrap:wrap;justify-content:center;'>\\n<button id='leftBtn' style='background:#1b1b3a;color:#aaf;border:1px solid #555;border-radius:8px;padding:8px 14px;font-size:16px;touch-action:none;user-select:none;'>◀</button>\\n<button id='fireBtn' style='background:#1b1b3a;color:#ff9;border:1px solid #555;border-radius:8px;padding:8px 14px;font-size:16px;touch-action:none;user-select:none;'>●</button>\\n<button id='rightBtn' style='background:#1b1b3a;color:#aaf;border:1px solid #555;border-radius:8px;padding:8px 14px;font-size:16px;touch-action:none;user-select:none;'>▶</button>\\n</div>\\n<p id='status' style='margin:8px 0 0;font-size:12px;color:#889;'>Press SPACE or tap canvas to start</p>\\n</div>\\n<script>\\n(function(){var canvas=document.getElementById('game');var ctx=canvas.getContext('2d');var W=360,H=480;var keys={left:false,right:false,up:false,down:false,fire:false};var stars=[];for(var i=0;i<80;i++){stars.push({x:Math.random()*W,y:Math.random()*H,s:Math.random()*2+0.5});}var ship={x:W/2,y:H-40,w:28,h:26,speed:260};var bullets=[],eBullets=[],enemies=[],particles=[];var score=0,lives=3,state='idle',enemyTimer=0,shootCd=0,inv=0,last=0,high=0;function reset(){ship.x=W/2;ship.y=H-40;bullets=[];eBullets=[];enemies=[];particles=[];score=0;lives=3;enemyTimer=0;shootCd=0;inv=0;state='playing';}function spawnEnemy(){var x=30+Math.random()*(W-60);var y=-20;var speed=40+Math.random()*40;var colors=['#ff5f7a','#ffa94d','#ffd43b','#69db7c','#4dabf7','#b197fc'];var color=colors[Math.floor(Math.random()*colors.length)];enemies.push({x:x,y:y,w:28,h:20,speed:speed,color:color,phase:Math.random()*Math.PI*2});}function shoot(){bullets.push({x:ship.x,y:ship.y-14,w:3,h:10,speed:480});}function explode(x,y,color){for(var i=0;i<10;i++){particles.push({x:x,y:y,vx:(Math.random()-0.5)*160,vy:(Math.random()-0.5)*160,life:0.5,color:color});}}function update(dt){if(keys.left){ship.x-=ship.speed*dt;}if(keys.right){ship.x+=ship.speed*dt;}if(keys.up){ship.y-=ship.speed*dt;}if(keys.down){ship.y+=ship.speed*dt;}ship.x=Math.max(14,Math.min(W-14,ship.x));ship.y=Math.max(H-60,Math.min(H-12,ship.y));if(keys.fire){shootCd-=dt;if(shootCd<=0){shoot();shootCd=0.22;}}enemyTimer-=dt;if(enemyTimer<=0){spawnEnemy();enemyTimer=0.7+Math.random()*0.8;}var i,j,e,b,p;for(i=enemies.length-1;i>=0;i--){e=enemies[i];e.y+=e.speed*dt;e.x+=Math.sin(e.phase+e.y*0.02)*0.8;if(e.y>H+30){enemies.splice(i,1);lives--;if(lives<=0){if(score>high){high=score;}state='over';}}}for(i=bullets.length-1;i>=0;i--){b=bullets[i];b.y-=b.speed*dt;if(b.y<-20){bullets.splice(i,1);continue;}for(j=enemies.length-1;j>=0;j--){e=enemies[j];if(b.x>e.x-e.w/2&&b.x<e.x+e.w/2&&b.y>e.y-e.h/2&&b.y<e.y+e.h/2){explode(e.x,e.y,e.color);score+=10;enemies.splice(j,1);bullets.splice(i,1);break;}}}if(inv>0){inv-=dt;}for(i=enemies.length-1;i>=0;i--){e=enemies[i];if(inv<=0&&ship.x+ship.w/2>e.x-e.w/2&&ship.x-ship.w/2<e.x+e.w/2&&ship.y+ship.h/2>e.y-e.h/2&&ship.y-ship.h/2<e.y+e.h/2){explode(ship.x,ship.y,'#7df');lives--;inv=1.5;enemies.splice(i,1);if(lives<=0){if(score>high){high=score;}state='over';}}}for(i=particles.length-1;i>=0;i--){p=particles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;if(p.life<=0){particles.splice(i,1);}}}function draw(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#05050f';ctx.fillRect(0,0,W,H);var i,s,e,b,p;for(i=0;i<stars.length;i++){s=stars[i];ctx.fillStyle='rgba(180,180,255,'+(s.s*0.2)+')';ctx.fillRect(s.x,s.y,1.5,1.5);}if(state==='idle'){ctx.fillStyle='#7df';ctx.font='bold 22px monospace';ctx.textAlign='center';ctx.fillText('RETRO SPACE',W/2,H/2-40);ctx.fillText('SHOOTER',W/2,H/2-16);ctx.fillStyle='#aaf';ctx.font='12px monospace';ctx.fillText('ARROWS / A D to move',W/2,H/2+20);ctx.fillText('SPACE to fire',W/2,H/2+38);ctx.fillText('Press SPACE or tap to start',W/2,H/2+66);ctx.textAlign='left';return;}ctx.save();if(inv>0&&Math.floor(inv*10)%2===0){ctx.globalAlpha=0.4;}ctx.fillStyle='#7df';ctx.beginPath();ctx.moveTo(ship.x,ship.y-ship.h/2);ctx.lineTo(ship.x-ship.w/2,ship.y+ship.h/2);ctx.lineTo(ship.x+ship.w/2,ship.y+ship.h/2);ctx.closePath();ctx.fill();ctx.fillStyle='#fff';ctx.fillRect(ship.x-3,ship.y+ship.h/2,6,6);ctx.restore();for(i=0;i<enemies.length;i++){e=enemies[i];ctx.fillStyle=e.color;ctx.fillRect(e.x-e.w/2,e.y-e.h/2,e.w,e.h);ctx.fillStyle='#000';ctx.fillRect(e.x-e.w/4,e.y-e.h/4,e.w/2,e.h/2);}ctx.fillStyle='#ffe066';for(i=0;i<bullets.length;i++){b=bullets[i];ctx.fillRect(b.x-b.w/2,b.y-b.h/2,b.w,b.h);}for(i=0;i<particles.length;i++){p=particles[i];ctx.fillStyle=p.color;ctx.globalAlpha=Math.max(0,p.life*2);ctx.fillRect(p.x-1.5,p.y-1.5,3,3);}ctx.globalAlpha=1;ctx.fillStyle='#aaf';ctx.font='12px monospace';ctx.fillText('SCORE '+score,10,18);ctx.fillText('LIVES '+lives,W-80,18);if(state==='over'){ctx.fillStyle='rgba(0,0,0,0.65)';ctx.fillRect(0,0,W,H);ctx.fillStyle='#ff5f7a';ctx.font='bold 22px monospace';ctx.textAlign='center';ctx.fillText('GAME OVER',W/2,H/2-20);ctx.fillStyle='#fff';ctx.font='12px monospace';ctx.fillText('SCORE '+score,W/2,H/2+10);ctx.fillText('BEST '+high,W/2,H/2+28);ctx.fillText('Press SPACE or tap to restart',W/2,H/2+50);ctx.textAlign='left';}}function loop(now){if(!last){last=now;}var dt=Math.min((now-last)/1000,0.05);last=now;if(state==='playing'){update(dt);}draw();requestAnimationFrame(loop);}requestAnimationFrame(loop);document.addEventListener('keydown',function(e){if(e.code==='ArrowLeft'||e.code==='KeyA'){keys.left=true;e.preventDefault();}if(e.code==='ArrowRight'||e.code==='KeyD'){keys.right=true;e.preventDefault();}if(e.code==='ArrowUp'||e.code==='KeyW'){keys.up=true;e.preventDefault();}if(e.code==='ArrowDown'||e.code==='KeyS'){keys.down=true;e.preventDefault();}if(e.code==='Space'){keys.fire=true;e.preventDefault();if(state!=='playing'){reset();}}});document.addEventListener('keyup',function(e){if(e.code==='ArrowLeft'||e.code==='KeyA'){keys.left=false;}if(e.code==='ArrowRight'||e.code==='KeyD'){keys.right=false;}if(e.code==='ArrowUp'||e.code==='KeyW'){keys.up=false;}if(e.code==='ArrowDown'||e.code==='KeyS'){keys.down=false;}if(e.code==='Space'){keys.fire=false;}});canvas.addEventListener('pointerdown',function(e){e.preventDefault();var r=canvas.getBoundingClientRect();ship.x=(e.clientX-r.left)*canvas.width/r.width;if(state!=='playing'){reset();keys.fire=false;}else{shoot();keys.fire=true;}});canvas.addEventListener('pointermove',function(e){if(state!=='playing'){return;}var r=canvas.getBoundingClientRect();ship.x=(e.clientX-r.left)*canvas.width/r.width;});canvas.addEventListener('pointerup',function(e){keys.fire=false;});canvas.addEventListener('pointerleave',function(){keys.fire=false;});function bindBtn(id,key){var el=document.getElementById(id);function start(ev){ev.preventDefault();keys[key]=true;if(state!=='playing'&&key==='fire'){reset();}}function end(ev){ev.preventDefault();keys[key]=false;}el.addEventListener('pointerdown',start);el.addEventListener('pointerup',end);el.addEventListener('pointerleave',end);}bindBtn('leftBtn','left');bindBtn('rightBtn','right');bindBtn('fireBtn','fire');})();\\n</script>\"",
